<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <record id="view_terrain_washing_station_list" model="ir.ui.view">
    <field name="name">terrain.washing_station.list</field>
    <field name="model">terrain.washing_station</field>
    <field name="arch" type="xml">
      <list string="Washing Stations">
        <field name="name"/>
        <field name="supplier_id"/>
        <field name="mill_type"/>
        <field name="altitude"/>
        <field name="capacity_kg_day"/>
        <field name="farm_count"/>
        <field name="certifications"/>
      </list>
    </field>
  </record>

  <record id="view_terrain_washing_station_form" model="ir.ui.view">
    <field name="name">terrain.washing_station.form</field>
    <field name="model">terrain.washing_station</field>
    <field name="arch" type="xml">
      <form string="Washing Station">
        <sheet>
          <group>
            <group string="Identity">
              <field name="name"/>
              <field name="supplier_id"/>
              <field name="company_id" groups="base.group_multi_company"/>
              <field name="certifications"/>
            </group>
            <group string="Location">
              <field name="latitude"/>
              <field name="longitude"/>
              <field name="altitude"/>
            </group>
          </group>
          <group>
            <group string="Capacity">
              <field name="mill_type"/>
              <field name="capacity_kg_day"/>
            </group>
          </group>
          <notebook>
            <page string="Farms Served">
              <field name="farm_ids">
                <list>
                  <field name="name"/>
                  <field name="supplier_id"/>
                  <field name="region"/>
                  <field name="variety"/>
                </list>
              </field>
            </page>
            <page string="Lots Processed">
              <field name="lot_ids">
                <list>
                  <field name="lot_code"/>
                  <field name="name"/>
                  <field name="grade"/>
                  <field name="process"/>
                  <field name="export_ready_date"/>
                </list>
              </field>
            </page>
          </notebook>
        </sheet>
        <chatter/>
      </form>
    </field>
  </record>

  <record id="action_terrain_washing_station" model="ir.actions.act_window">
    <field name="name">Washing Stations</field>
    <field name="res_model">terrain.washing_station</field>
    <field name="view_mode">list,form</field>
  </record>

</odoo>
