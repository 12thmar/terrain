<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <record id="view_terrain_farm_list" model="ir.ui.view">
    <field name="name">terrain.farm.list</field>
    <field name="model">terrain.farm</field>
    <field name="arch" type="xml">
      <list string="Farms">
        <field name="name"/>
        <field name="supplier_id"/>
        <field name="region"/>
        <field name="zone"/>
        <field name="altitude_min"/>
        <field name="altitude_max"/>
        <field name="variety"/>
        <field name="farmer_count"/>
        <field name="photo_count"/>
        <field name="state"/>
      </list>
    </field>
  </record>

  <record id="view_terrain_farm_form" model="ir.ui.view">
    <field name="name">terrain.farm.form</field>
    <field name="model">terrain.farm</field>
    <field name="arch" type="xml">
      <form string="Farm">
        <header>
          <field name="state" widget="statusbar" statusbar_visible="draft,submitted,approved,active"/>
        </header>
        <sheet>
          <div class="oe_button_box" name="button_box">
            <button class="oe_stat_button" icon="fa-users" type="object" name="action_view_farmers">
              <field name="farmer_count" widget="statinfo" string="Farmers"/>
            </button>
            <button class="oe_stat_button" icon="fa-camera" type="object" name="action_view_photos">
              <field name="photo_count" widget="statinfo" string="Photos"/>
            </button>
          </div>
          <group>
            <group string="Identity">
              <field name="name"/>
              <field name="supplier_id"/>
              <field name="company_id" groups="base.group_multi_company"/>
            </group>
            <group string="Location">
              <field name="region"/>
              <field name="zone"/>
              <field name="altitude_min"/>
              <field name="altitude_max"/>
              <field name="latitude"/>
              <field name="longitude"/>
            </group>
          </group>
          <group>
            <group string="Production">
              <field name="size_hectares"/>
              <field name="variety"/>
              <field name="harvest_months"/>
            </group>
          </group>
          <notebook>
            <page string="Farmers">
              <field name="farmer_ids">
                <list>
                  <field name="name"/>
                  <field name="phone"/>
                  <field name="years_experience"/>
                </list>
              </field>
            </page>
            <page string="Photos">
              <field name="photo_ids">
                <list>
                  <field name="s3_url"/>
                  <field name="exif_lat"/>
                  <field name="exif_lng"/>
                  <field name="taken_at"/>
                  <field name="notes"/>
                </list>
              </field>
            </page>
            <page string="Washing Stations">
              <field name="washing_station_ids">
                <list>
                  <field name="name"/>
                  <field name="mill_type"/>
                  <field name="altitude"/>
                </list>
              </field>
            </page>
            <page string="Lots">
              <field name="lot_ids">
                <list>
                  <field name="lot_code"/>
                  <field name="name"/>
                  <field name="grade"/>
                  <field name="process"/>
                  <field name="export_ready_date"/>
                </list>
              </field>
            </page>
          </notebook>
        </sheet>
        <chatter/>
      </form>
    </field>
  </record>

  <record id="action_terrain_farm" model="ir.actions.act_window">
    <field name="name">Farms</field>
    <field name="res_model">terrain.farm</field>
    <field name="view_mode">list,form</field>
  </record>

</odoo>
